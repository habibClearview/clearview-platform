{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "plugins": [
    "react-hooks",
    "@typescript-eslint"
  ],
  "globals": {
    "React": "readonly",
    "RequestInit": "readonly",
    "RequestCredentials": "readonly",
    "JSX": "readonly",
    "NodeJS": "readonly"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["src/components/coach/*.tsx"],
      "rules": {
        "@typescript-eslint/no-use-before-define": ["error", { "functions": false, "classes": false, "variables": true, "typedefs": false, "enums": false, "ignoreTypeReferences": true }]
      }
    }
  ]
}
